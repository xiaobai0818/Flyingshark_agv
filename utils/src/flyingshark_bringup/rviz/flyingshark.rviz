Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
    - Class: rviz/RobotModel
      Enabled: true
      Name: Robot
      Robot Description: robot_description
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Names: false
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/color/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGB
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Class: rviz/LaserScan
      Enabled: true
      Name: Laser
      Topic: /scan
      Size (m): 0.03
    - Alpha: 0.7
      Arrow Length: 0.2
      Class: rviz/PoseArray
      Color: 85; 255; 255
      Enabled: true
      Name: AMCL
      Shape: Arrow
      Topic: /particlecloud
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: RGBCloud
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.02
      Style: Points
      Topic: /camera/rgb_points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Name: DepthCloud
      Position Transformer: XYZ
      Queue Size: 1
      Size (Pixels): 3
      Style: Points
      Topic: /camera/depth/points
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: GlobalCostmap
      Topic: /move_base/global_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.85
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: LocalCostmap
      Topic: /move_base/local_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: GlobalPlan
      Topic: /move_base/GlobalPlanner/plan
      Color: 25; 255; 0
    - Class: rviz/Path
      Enabled: true
      Name: LocalPlan
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Color: 255; 85; 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
